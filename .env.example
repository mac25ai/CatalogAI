# Set these in the Railway dashboard (Project -> Variables), not in a
# local .env file -- the app reads them straight from the environment,
# no python-dotenv, no .env loading. Locally, everything below is optional:
# the app falls back to mock chatbot replies, the dev session secret, and
# admin_credentials.json for passwords.

# Real chatbot (routers/chatbot.py). Without this, /api/chat/[slug] falls
# back to the deterministic mock responses.
GROQ_API_KEY=

# Signs the admin session cookie. Generate a random 32+ char string.
SESSION_SECRET=

# One per client slug: ADMIN_PASS_<SLUG_UPPERCASE_WITH_UNDERSCORES>.
# Takes priority over admin_credentials.json when set.
ADMIN_PASS_ZARA_PERFUMES=
ADMIN_PASS_HENNA_HOUSE=

# Password-reset emails (services/email_service.py, routers/admin.py
# forgot-password flow). Sent via the Resend HTTPS API, not SMTP --
# Railway blocks all outbound SMTP on the Hobby plan, so no SMTP
# provider works here regardless of host/credentials. Without these,
# reset links are logged to the console/server logs instead of emailed
# -- MAC25AI can relay the link manually until Resend is set up.
# Get RESEND_API_KEY from resend.com after verifying a sending domain.
RESEND_API_KEY=
EMAIL_FROM=CatalogAI <password-reset@mac25ai.com>
